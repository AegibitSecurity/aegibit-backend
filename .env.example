# Copy to .env — never commit the real .env to version control.

# REQUIRED in production: set a stable 64-char hex secret.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_GENERATE_A_REAL_SECRET

# Database (SQLite default for dev, PostgreSQL for production)
# DATABASE_URL=postgresql://user:password@host:5432/aegibit_flow
DATABASE_URL=sqlite:///./aegibit_flow.db

# Server
HOST=0.0.0.0
PORT=8000
JWT_EXPIRY_HOURS=24

# CORS — comma-separated allowed origins (no trailing slash, no spaces)
# CORS_ORIGINS=https://app.aegibit.com,https://www.aegibit.com
